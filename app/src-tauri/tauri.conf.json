{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lillypad Launcher",
  "version": "0.1.0",
  "identifier": "se.lillypadnetwork.launcher",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Lillypad Launcher",
        "width": 960,
        "height": 600,
        "resizable": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; base-uri 'none'; form-action 'none'; object-src 'none'",
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "Lillypad Network",
    "copyright": "Copyright (c) 2026 Lillypad Network",
    "shortDescription": "Launcher for the Lulumon Create server"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZGNkNGQTVGNTc0RjY0ODEKUldTQlpFOVhYL3BzLzRNcmgzbmVNMUxTWHJwR2RnZjZYZTIvQ1VDZ2dlOE1ZK1dXemNTN2N5QVoK",
      "endpoints": [
        "https://lillypadnetwork.se/launcher/latest.json"
      ]
    }
  }
}
